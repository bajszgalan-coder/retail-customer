import pandas as pd
import numpy as np

path = "../project_data/project_transactions.csv"
columns = ["household_key","BASKET_ID", "DAY", "PRODUCT_ID", "QUANTITY", "SALES_VALUE"]

transactions = pd.read_csv(path,
                           usecols = columns
).astype({
    "DAY" : "Int16",
    "QUANTITY" : "Int32",
    "PRODUCT_ID" : "Int32"
})


transactions = (
    transactions
    .assign(date = (pd.to_datetime("2016", format='%Y') 
                    + pd.to_timedelta(transactions["DAY"].sub(1).astype(str) + " days"))
           )
    .drop(["DAY"], axis=1)
)
