transactions.set_index("date").loc[:, "SALES_VALUE"].resample("ME").sum().plot()

(transactions
 .set_index("date")
 .sort_index() # mit sort_index() werden die index sortiert 
 .loc["2016-04":"2017-10", "SALES_VALUE"] 
